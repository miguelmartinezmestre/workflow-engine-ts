{
  "name": "workflow-engine-ts",
  "version": "0.0.1",
  "description": "Bidirectional visual editor for Effect workflows",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "cf:dev": "wrangler dev",
    "cf:deploy": "wrangler deploy",
    "cf:types": "wrangler types"
  },
  "keywords": [
    "effect",
    "typescript",
    "workflow",
    "react-flow",
    "cloudflare-workers"
  ],
  "license": "MIT",
  "peerDependencies": {
    "effect": "^4.0.0-rc.113"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260910.0",
    "@types/node": "^26.0.0",
    "effect": "^4.0.0-rc.113",
    "typescript": "^6.0.0",
    "vitest": "^4.0.0",
    "wrangler": "^4.0.0"
  },
  "packageManager": "pnpm@11.19.0"
}
