{
  "name": "workflow-engine-ts",
  "version": "0.0.1",
  "description": "Bidirectional visual editor for Effect workflows",
  "type": "module",
  "sideEffects": false,
  "files": ["dist"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:lib": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "deploy": "vite build && wrangler deploy",
    "cf:dev": "vite",
    "cf:deploy": "vite build && wrangler deploy",
    "cf:types": "wrangler types"
  },
  "keywords": ["effect", "typescript", "workflow", "react-flow", "cloudflare-workers"],
  "license": "MIT",
  "peerDependencies": {
    "effect": "^4.0.0-rc.113"
  },
  "dependencies": {
    "@xyflow/react": "^12.8.6",
    "effect": "^4.0.0-rc.113",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.13.14",
    "@cloudflare/workers-types": "^4.20260910.0",
    "@types/node": "^26.0.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "typescript": "^6.0.0",
    "vite": "^7.1.5",
    "vitest": "^4.0.0",
    "wrangler": "^4.0.0"
  },
  "packageManager": "pnpm@11.19.0"
}
