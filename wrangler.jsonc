{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "workflow-engine-ts",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-10",
  "observability": {
    "enabled": true
  },
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "kv_namespaces": [
    {
      "binding": "WORKFLOWS",
      "id": "REPLACE_WITH_KV_NAMESPACE_ID"
    }
  ]
}
